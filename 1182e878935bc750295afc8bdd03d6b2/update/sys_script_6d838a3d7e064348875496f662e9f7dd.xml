        <script><![CDATA[(function executeRule(current, previous) {
    if (!current.getValue('employee')) {
        current.setValue('employee', gs.getUserID());
    }
    var employeeId = current.getValue('employee');
    if (employeeId) {
        var user = new GlideRecord('sys_user');
        if (user.get(employeeId)) {
            var managerId = user.getValue('manager');
            if (managerId) {
                current.setValue('manager', managerId);
            }
        }
    }
})(current, previous);]]></script>
